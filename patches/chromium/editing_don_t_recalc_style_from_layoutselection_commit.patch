 }
 
+namespace {
+
+// Uploads one report per process naming what left the layout tree dirty at
+// compositing-inputs time, so the deferral below can be traced to its cause.
+void ReportDirtyTreeAtCommit(Document& document) {
+  static bool reported = false;
+  if (reported) {
+    return;
+  }
+  reported = true;
+  StyleEngine& engine = document.GetStyleEngine();
+  std::string bits;
+  auto add = [&bits](bool set, const char* name) {
+    if (set) {
+      bits += name;
+      bits += ',';
+    }
+  };
+  add(engine.NeedsFullStyleUpdate(), "full");
+  add(engine.NeedsActiveStyleUpdate(), "active");
+  add(engine.NeedsStyleRecalc(), "recalc");
+  add(engine.NeedsStyleInvalidation(), "invalidation");
+  add(document.ChildNeedsStyleRecalc(), "child-recalc");
+  add(document.NeedsStyleInvalidation(), "doc-invalidation");
+  add(document.IsSlotAssignmentDirty(), "slots");
+  add(document.GetDocumentAnimations().NeedsAnimationTimingUpdate(),
+      "anim-timing");
+  add(document.View() && document.View()->NeedsLayout(), "layout");
+  add(document.LocalOwner(), "subframe");
+  SCOPED_CRASH_KEY_STRING64("LayoutSelection", "dirty", bits);
+  SCOPED_CRASH_KEY_NUMBER("LayoutSelection", "lifecycle",
+                          static_cast<int>(document.Lifecycle().GetState()));
+  base::debug::DumpWithoutCrashing();
+}
+
+}  // namespace
+
 void LayoutSelection::Commit() {
   if (!has_pending_selection_)
     return;
+
+  // CalcSelectionRangeAndSetSelectionState() reaches
+  // FrameSelection::SelectionHasFocus(), which updates style and layout. That
+  // is only safe as a no-op here: this runs in the compositing-inputs phase,
+  // where a real recalc CHECK-fails on StateAllowsTreeMutations(). Style can
+  // be dirty at this point without the lifecycle having rewound (e.g. an
+  // animation timing update became due), so commit on the next frame instead.
+  Document& document = frame_selection_->GetDocument();
+  if (document.NeedsLayoutTreeUpdate()) {
+    ReportDirtyTreeAtCommit(document);
+    document.View()->ScheduleAnimation();
+    return;
+  }
   has_pending_selection_ = false;
 
-  DCHECK(!frame_selection_->GetDocument().NeedsLayoutTreeUpdate());
-  DCHECK_GE(frame_selection_->GetDocument().Lifecycle().GetState(),
-            DocumentLifecycle::kLayoutClean);
+  DCHECK_GE(document.Lifecycle().GetState(), DocumentLifecycle::kLayoutClean);
   DocumentLifecycle::DisallowTransitionScope disallow_transition(
       frame_selection_->GetDocument().Lifecycle());
 
